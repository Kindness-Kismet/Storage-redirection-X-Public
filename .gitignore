# 默认忽略文件，只放行产品、构建输入与共享规范。
*
!/.gitignore
!/.gitmodules
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/LICENSE
!/Cargo.toml
!/Cargo.lock

# 项目技能入口，只放行这一份配置。
!/.pi/
!/.pi/settings.json

# Android 源码、资源与 Gradle wrapper。
!/android/
!/android/*.kts
!/android/gradle.properties
!/android/gradlew*
!/android/gradle/
!/android/gradle/**/
!/android/gradle/libs.versions.toml
!/android/gradle/wrapper/gradle-wrapper.*
!/android/app/
!/android/app/build.gradle.kts
!/android/app/proguard-rules.pro
!/android/app/src/
!/android/app/src/**/
!/android/app/src/main/**/*.kt
!/android/app/src/debug/**/*.kt
!/android/app/src/main/**/*.xml
!/android/app/src/debug/**/*.xml
!/android/app/src/main/res/**/*.png
!/android/app/src/main/res/resources.properties

# Rust、Java Hook 与原生依赖；不放行生成的 DEX、库或补丁存档。
!/srx_core/
!/srx_core/Cargo.toml
!/srx_core/build.rs
!/srx_core/src/
!/srx_core/src/**/
!/srx_core/src/**/*.rs
!/srx_core/java_src/
!/srx_core/java_src/**/
!/srx_core/java_src/**/*.java
!/srx_core/native/
!/srx_core/native/CMakeLists.txt
!/srx_core/native/*.cpp
!/srx_core/native/cmake/
!/srx_core/native/cmake/**/
!/srx_core/native/cmake/**/*.cmake

# 独立维护的第三方库子模块。
!/srx_core/third_party/
!/srx_core/third_party/srx_inline_hook
!/srx_core/third_party/lsplant

# 构建脚本与模块安装、运行资源。
!/scripts/
!/scripts/*.py
!/assets/
!/assets/zygisk_module/
!/assets/zygisk_module/*.sh
!/assets/zygisk_module/sepolicy.rule
!/assets/zygisk_module/service.d/
!/assets/zygisk_module/service.d/*.sh
!/assets/zygisk_module/META-INF/
!/assets/zygisk_module/META-INF/**/
!/assets/zygisk_module/META-INF/com/google/android/update-binary
!/assets/zygisk_module/META-INF/com/google/android/updater-script

# 现有 CI 与发布输入，不放行普通说明文档。
!/.github/
!/.github/CHANGELOG.md
!/.github/docs/
!/.github/docs/README.zh-CN.md
!/.github/workflows/
!/.github/workflows/*.yml
!/.github/tests/
!/.github/tests/*.sh
!/.github/vendor/
!/.github/vendor/rootAVD/
!/.github/vendor/rootAVD/*.sh
!/.github/vendor/rootAVD/*.bat

# 共享技能；其他调试技能与会话保持本地。
!/.claude/
!/.claude/skills/
!/.claude/skills/commit/
!/.claude/skills/commit/SKILL.md
!/.claude/skills/pull-request/
!/.claude/skills/pull-request/SKILL.md
!/.claude/skills/version-bump/
!/.claude/skills/version-bump/SKILL.md
!/.codex/
!/.codex/skills/
!/.codex/skills/commit/
!/.codex/skills/commit/SKILL.md
!/.codex/skills/pull-request/
!/.codex/skills/pull-request/SKILL.md
!/.codex/skills/version-bump/
!/.codex/skills/version-bump/SKILL.md
